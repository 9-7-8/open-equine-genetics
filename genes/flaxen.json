  "phenotypes": [
    { "id": "wild", "name": "Wild type", "description": "The mane and tail are the colour of the body. On a horse that makes black hair this is what every combination looks like - flaxen only shows on a chestnut.", "changes_coat": false },
    { "id": "mild-flaxen", "name": "Mild flaxen", "description": "Red long hair shot through with gold and cream strands - enough to notice, not enough to call the horse flaxen at a distance.", "changes_coat": true },
    { "id": "flaxen", "name": "Flaxen", "description": "Clearly blond mane, tail and forelock over a red body: the classic flaxen chestnut.", "changes_coat": true },
