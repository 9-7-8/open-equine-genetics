    { "id": "black", "name": "Black", "description": "No working copy, so black pigment is not restricted and covers the whole body.", "changes_coat": true },
    { "id": "masked", "name": "Hidden on chestnut", "description": "The horse is e/e at extension and makes no black pigment for agouti to place, so it is chestnut whatever its agouti genotype. The genotype is carried unseen and passed on.", "changes_coat": false },
    { "id": "proposed-allele", "name": "Pair with a proposed allele", "documented": false, "description": "A pair that includes At or A+. Both names are in wide use - At for seal brown (very dark, with reddish-tan soft points at the muzzle, eyes, flanks, elbows and groin), A+ for wild bay (black leg points stopping low, near the fetlock) - and both looks are real, but neither has been validated as an allele of agouti; UC Davis recognises A and a only, and the looks may come from shade, sooty or other modifiers. They are kept as proposed, unvalidated alleles; no outcome can be given for them.", "changes_coat": true }
