  "name": "Agouti",
  "symbol": "ASIP",
  "evidence": "published",
  "summary": "Where black pigment is allowed to sit. a/a leaves black over the whole horse (plain black, or chestnut if extension already removed it); one A copy restricts black toward the points, making a bay. How far it is restricted is the shade locus's business, and that is what makes a bay a blood bay, an ordinary bay, a liver bay or a seal brown.",
  "inheritance": "autosomal",
  "affects_coat": true,
  "alleles": [
    { "id": "A", "name": "Agouti / bay", "wild_type": false, "quality": "unverified" },
    { "id": "a", "name": "Non-agouti", "wild_type": true, "quality": "unverified" }
  ],
  "phenotypes": [
    { "id": "wild", "name": "Wild type", "description": "Black pigment is not restricted, so it covers the whole horse - a plain black, or a chestnut if extension already removed it.", "changes_coat": false },
    { "id": "blood-bay", "name": "Blood bay", "description": "The red end of the bay range: a saturated copper-red body with crisp black mane, tail, ears and hooves, and black barely climbing the legs.", "changes_coat": true },
    { "id": "bay", "name": "Bay", "description": "The ordinary bay: a red-brown body with black mane, tail, ears and hooves, and black climbing the legs and a little of the face.", "changes_coat": true },
    { "id": "liver-bay", "name": "Liver bay", "description": "A dark mahogany or chocolate body - still visibly red rather than black - with the black points running well up the legs and over the muzzle.", "changes_coat": true },
    { "id": "seal-brown", "name": "Seal brown", "description": "Near-black at a distance, and given away by the soft tan points a seal brown keeps: a mealy muzzle, a paler ring over the eye, and light patches at the elbow and the flank.", "changes_coat": true }
  ],
