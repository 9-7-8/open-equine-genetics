    { "id": "At", "name": "Seal brown, proposed (invalid: not a validated allele)", "wild_type": false, "quality": "invalid" },
    { "id": "A+", "name": "Wild bay, proposed (invalid: not a validated allele)", "wild_type": false, "quality": "invalid" }
  ],
  "phenotypes": [
    { "id": "bay", "name": "Bay", "description": "Black pigment is restricted to the points - mane, tail, lower legs and ear rims - over a red body. One working copy is enough.", "changes_coat": true },
    { "id": "black", "name": "Black", "description": "No working copy, so black pigment is not restricted and covers the whole body.", "changes_coat": true },
    { "id": "masked", "name": "Hidden on chestnut", "description": "The horse is e/e at extension and makes no black pigment for agouti to place, so it is chestnut whatever its agouti genotype. The genotype is carried unseen and passed on.", "changes_coat": false },
    { "id": "invalid-allele", "name": "Pair with an invalid allele", "documented": false, "description": "A pair that includes At or A+. Both names are in wide use - At for seal brown, A+ for wild bay - but neither has been validated as an allele of agouti; UC Davis recognises A and a only, and the shades they were proposed to explain may come from a separate modifier. They are kept, marked invalid, so that they are not added as real by mistake. No outcome can be given for them.", "changes_coat": true }
