  "phenotypes": [
    { "id": "wild", "name": "Wild type", "description": "A brown eye - what nearly every horse has.", "changes_coat": false },
    { "id": "eye-colour-carrier", "name": "Eye colour carrier", "description": "One copy of something other than brown, which shows nothing: every variant at this locus is recessive to brown.", "changes_coat": false },
    { "id": "eye-colour-mismatched", "name": "Two different eye colours", "description": "Two different non-brown variants, which is a brown eye. Each is recessive to the other as well as to brown, so a horse shows one only by carrying the same one twice.", "changes_coat": false },
    { "id": "eye-green-left", "name": "Green eye", "description": "A clear green iris - the colour the cream/pearl compound used to paint directly, and now the colour it asks for.", "changes_coat": true },
    { "id": "eye-gold-left", "name": "Gold eye", "description": "A warm gold, the colour of a hawk's eye. Tiger eye and champagne both request this rather than owning a shade of their own.", "changes_coat": true },
    { "id": "eye-dark-blue-left", "name": "Dark blue eye", "description": "A deep blue, dark enough to read as almost black at distance and unmistakable close up.", "changes_coat": true },
    { "id": "eye-mid-blue-left", "name": "Mid blue eye", "description": "The pale, cool blue of a splashed white horse - which is exactly what the four white loci request when a horse is white enough to have it.", "changes_coat": true },
    { "id": "eye-light-blue-left", "name": "Light blue eye", "description": "Blue washed almost to white. The palest iris that still reads as an iris at two texels.", "changes_coat": true },
    { "id": "eye-white-left", "name": "White eye", "description": "A white iris in a white sclera - an eye that is all one colour, with only the antialiased rim to say where it ends.", "changes_coat": true },
    { "id": "eye-red-left", "name": "Red eye", "description": "A deep blood red - the dhampir's eye. With a glowing sclera beside it, it is the face the Dhampir breed is known by; on its own it is simply a rare and unsettling horse.", "changes_coat": true },
    { "id": "eye-chaos-left", "name": "Chaos eye", "description": "A colour written on the allele copy rather than on the allele, so no two chaos-eyed horses match and a line of them drifts.", "changes_coat": true },
    { "id": "eye-invisible-left", "name": "Invisible eye", "description": "No iris is painted at all - the coat on the head shows straight through where the eye should be. Nothing further down this eye's stack shows either: no sector, no glow.", "changes_coat": true },
    { "id": "eye-black-left", "name": "Black eye", "description": "A flat black iris - the eye of the undead horses. Nothing wild carries it; a breed has to have kept it.", "changes_coat": true }
  ],
