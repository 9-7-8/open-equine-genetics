  "phenotypes": [
    { "id": "wild", "name": "Wild type", "description": "A brown eye - what nearly every horse has.", "changes_coat": false },
    { "id": "eye-colour-carrier", "name": "Eye colour carrier", "description": "One copy of something other than brown, which shows nothing: every variant at this locus is recessive to brown.", "changes_coat": false },
    { "id": "eye-colour-mismatched", "name": "Two different eye colours", "description": "Two different non-brown variants, which is a brown eye. Each is recessive to the other as well as to brown, so a horse shows one only by carrying the same one twice.", "changes_coat": false },
    { "id": "eye-green-left", "name": "Green eye", "description": "A clear green iris - the colour the cream/pearl compound used to paint directly, and now the colour it asks for.", "changes_coat": false },
    { "id": "eye-gold-left", "name": "Gold eye", "description": "A warm gold, the colour of a hawk's eye. Tiger eye and champagne both request this rather than owning a shade of their own.", "changes_coat": false },
    { "id": "eye-dark-blue-left", "name": "Dark blue eye", "description": "A deep blue, dark enough to read as almost black at distance and unmistakable close up.", "changes_coat": false },
    { "id": "eye-mid-blue-left", "name": "Mid blue eye", "description": "The pale, cool blue of a splashed white horse - which is exactly what the four white loci request when a horse is white enough to have it.", "changes_coat": false },
    { "id": "eye-light-blue-left", "name": "Light blue eye", "description": "Blue washed almost to white. The palest iris that still reads as an iris at two texels.", "changes_coat": false },
